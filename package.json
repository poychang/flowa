{
  "name": "flowa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-transform-types --test tests/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --project chromium",
    "test:cross-browser": "playwright test --project firefox --project webkit",
    "test:devices": "playwright test --config playwright.devices.config.ts",
    "build:devices": "node --env-file-if-exists=.env.device.local scripts/device.mjs build",
    "serve:devices": "node --env-file-if-exists=.env.device.local scripts/device.mjs serve",
    "test:device-server": "node --experimental-transform-types --test tests/device-server/*.test.mjs",
    "test:device-launcher": "node --test tests/device-launcher/*.test.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "dev:relay": "node --env-file-if-exists=.env.local --experimental-transform-types apps/relay/main.ts",
    "test:relay": "node --experimental-transform-types --test tests/relay/*.test.ts",
    "test:soak": "node --experimental-transform-types tests/relay/reconnect-soak.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "build:relay": "tsc -p tsconfig.relay.json",
    "start:relay": "node scripts/start-relay.mjs",
    "check:relay": "node scripts/check-relay.mjs",
    "test:relay-launcher": "node --test tests/relay-launcher/*.test.mjs",
    "package:relay": "node scripts/package-relay.mjs",
    "verify:relay": "node scripts/verify-relay-release.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "test:licenses": "node --test tests/licenses/*.test.mjs",
    "dev:all": "node --env-file-if-exists=.env.local scripts/dev.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "idb": "8.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "@types/react": "18.3.10",
    "@types/react-dom": "18.3.7",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
